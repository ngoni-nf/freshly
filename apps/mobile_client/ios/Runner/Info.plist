<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Freshly</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleName</key>
	<string>freshly</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>13.0</string>

	<!-- Permission strings. App Review rejects vague copy here, and users who
	     do not understand why we want location simply deny it. Each string
	     states the benefit to the person being asked. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Freshly uses your location to show beauty and grooming pros near you and to share your address with your pro once a booking is confirmed.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Freshly uses your location while a booking is active so you can see your pro on the way, and so emergency response can find you if you use SOS.</string>
	<key>NSCameraUsageDescription</key>
	<string>Freshly uses your camera so you can add photos to a review or share a picture of the style you want.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Freshly needs access to your photos so you can attach reference images to a booking or a review.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Freshly uses your microphone for voice search and for masked calls with your pro.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Freshly uses speech recognition so you can search for a service by speaking instead of typing.</string>
	<key>NSContactsUsageDescription</key>
	<string>Freshly can use your contacts so you can add an emergency contact quickly.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Freshly uses Face ID to protect your saved payment methods.</string>

	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
		<string>fetch</string>
	</array>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
