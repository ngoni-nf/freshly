<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the Android process starts, before Flutter draws. Matching
         it to the Freshly mint avoids the white flash that makes a cold start
         feel broken on slower handsets. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Applied once Flutter takes over the window. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
