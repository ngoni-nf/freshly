# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

# ─── Database ─────────────────────────────────────────────────────────────────
# Local Docker or a local PostgreSQL install:
DATABASE_URL=postgres://freshly:freshly@localhost:5432/freshly
DATABASE_SSL=false

# Supabase (Project settings -> Database -> Connection string).
# Use the DIRECT connection on port 5432 for migrations: they issue DDL and
# CREATE EXTENSION, which the transaction pooler on 6543 does not support.
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# DATABASE_SSL=true
#
# For a serverless or high-connection deployment, point the running API at the
# pooler instead and keep migrations on the direct URL:
# DATABASE_POOL_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
# Local, or WSL: sudo apt install redis-server && sudo service redis-server start
REDIS_URL=redis://localhost:6379
# Upstash, if you would rather not run one (free tier, TLS):
# REDIS_URL=rediss://default:PASSWORD@REGION.upstash.io:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Dev only: when true, OTP is always 000000 and is not dispatched over SMS
OTP_DEV_BYPASS=true

# ─── Encryption (POPIA / Zimbabwe DPA: PII at rest) ───────────────────────────
# 32-byte key, base64 encoded. Generate: openssl rand -base64 32
PII_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# ─── Payments: South Africa ───────────────────────────────────────────────────
PAYMENTS_ZA_PROVIDER=stitch          # stitch | peach | mock
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
STITCH_WEBHOOK_SECRET=
PEACH_ENTITY_ID=
PEACH_ACCESS_TOKEN=

# ─── Payments: Zimbabwe ───────────────────────────────────────────────────────
PAYMENTS_ZW_PROVIDER=paynow          # paynow | mock   (EcoCash / OneMoney / USD card)
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# ─── Storage (KYC documents, portfolio, avatars) ──────────────────────────────
# Without these the API mocks uploads: the flow works, nothing is stored.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS. It belongs in the API process and in
# no app, no browser and no repository.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ─── Payouts ──────────────────────────────────────────────────────────────────
# Money out is a separate vendor decision from money in. Both default to mock;
# production refuses to boot with PAYOUTS_ZA_PROVIDER=mock, because a mock
# adapter reports success and moves nothing.
PAYOUTS_ZA_PROVIDER=mock             # stitch | mock   (bank EFT)
PAYOUTS_ZW_PROVIDER=mock             # paynow | mock   (EcoCash / OneMoney / InnBucks)
STITCH_BASE_URL=https://secure.stitch.money

# ─── Identity / KYC ───────────────────────────────────────────────────────────
KYC_PROVIDER=smileid                 # smileid | mock
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
# Verification results arrive here asynchronously. Without it every provider
# sits in `pending` forever, unable to work and unable to see why.
SMILE_ID_CALLBACK_URL=
SMILE_ID_BASE_URL=https://api.smileidentity.com

# ─── Emergency response ───────────────────────────────────────────────────────
SOS_PROVIDER=aura                    # aura | mock
AURA_API_KEY=
AURA_BASE_URL=https://api.aura.services

# ─── Comms ────────────────────────────────────────────────────────────────────
COMMS_PROVIDER=gupshup               # gupshup | twilio | mock
GUPSHUP_API_KEY=
GUPSHUP_SOURCE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ─── Firebase ─────────────────────────────────────────────────────────────────
# Phone sign-in: the apps obtain a Firebase ID token, the API verifies it and
# issues its own JWT. Firebase proves who the caller is; authorisation stays
# ours, so a Firebase outage cannot grant anyone a role they do not have.
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
# Service account, either as a path or the raw JSON. Never commit either.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Push. Uses the same service account as above. Off here so a local API does
# not try to reach Google on every dispatch wave, but production refuses to
# boot without it: a dispatch offer that only reaches a foregrounded app means
# most bookings quietly go unfilled.
PUSH_ENABLED=false

# ─── AI ───────────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_ENABLED=true

# ─── Grid / load-shedding ─────────────────────────────────────────────────────
ESKOMSEPUSH_API_KEY=
ZESA_STATUS_FEED_URL=

# ─── Object storage ───────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=freshly-media
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_REGION=af-south-1

# Browser origins allowed to call this API, comma separated. Only enforced when
# NODE_ENV=production; development allows any origin so a device or emulator on
# the LAN can reach it. Empty in production means nothing is allowed, which
# fails visibly rather than leaving the API open to any site.
#   CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=
